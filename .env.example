# Dev Mode server settings. Copy to .env.local for local dev, or set them in
# Vercel → Settings → Environment Variables. Never commit real values.

# From `npm run hash-password` (scrypt hash; the password itself is never stored).
# In .env files write every $ as \$ (Vite expands $VARS); in the Vercel dashboard paste it as-is.
DEV_MODE_PASSWORD_HASH=
# Long random string (also printed by `npm run hash-password`)
SESSION_SECRET=

# Fine-grained GitHub token: portfolio repo only, Contents + Pull requests read/write.
# Without it, local `npm run dev` writes changes into this folder instead of GitHub.
GITHUB_WRITE_TOKEN=
# Optional, defaults to portfolio.config.js → repo
PORTFOLIO_REPO=
PORTFOLIO_BRANCH=

# Rate limiting store (Upstash Redis or Vercel KV). Strongly recommended in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob, for videos and 3D models too large for a serverless request.
BLOB_READ_WRITE_TOKEN=
